# Enable Powerlevel10k instant prompt. Should stay close to the top of ~/.zshrc.
# Initialization code that may require console input (password prompts, [y/n]
# confirmations, etc.) must go above this block; everything else may go below.
if [[ -r "${XDG_CACHE_HOME:-$HOME/.cache}/p10k-instant-prompt-${(%):-%n}.zsh" ]]; then
  source "${XDG_CACHE_HOME:-$HOME/.cache}/p10k-instant-prompt-${(%):-%n}.zsh"
fi

# If you come from bash you might have to change your $PATH.
# export PATH=$HOME/bin:$HOME/.local/bin:/usr/local/bin:$PATH

# Path to your Oh My Zsh installation.
export ZSH="$HOME/.oh-my-zsh"

export PATH="$HOME/bin:$HOME/.local/bin:/usr/local/bin:$PATH"
export PATH="$HOME/.rbenv/bin:$PATH"
export PATH="/snap/bin:$PATH"
export PATH="/sbin:/usr/sbin:$PATH"

eval "$(oh-my-posh init zsh --config ~/.ohmyposh/themes/clean-detailed.omp.json)"

# Set theme
# ZSH_THEME="robbyrussell"

# Load Oh My Zsh first
source $ZSH/oh-my-zsh.sh

# Plugins (pastikan semua plugin sudah diinstal)
plugins=(git zsh-autosuggestions zsh-syntax-highlighting fast-syntax-highlighting zsh-autocomplete)

#eval "$(oh-my-posh init zsh --config ~/.ohmyposh/themes/clean-detailed.omp.json)"
# Set name of the theme to load --- if set to "random", it will
# load a random theme each time Oh My Zsh is loaded, in which case,
# to know which specific one was loaded, run: echo $RANDOM_THEME
# See https://github.com/ohmyzsh/ohmyzsh/wiki/Themes

# Set list of themes to pick from when loading at random
# Setting this variable when ZSH_THEME=random will cause zsh to load
# a theme from this variable instead of looking in $ZSH/themes/
# If set to an empty array, this variable will have no effect.
# ZSH_THEME_RANDOM_CANDIDATES=( "robbyrussell" "agnoster" )

# Uncomment the following line to use case-sensitive completion.
# CASE_SENSITIVE="true"

# Uncomment the following line to use hyphen-insensitive completion.
# Case-sensitive completion must be off. _ and - will be interchangeable.
# HYPHEN_INSENSITIVE="true"

# Uncomment one of the following lines to change the auto-update behavior
# zstyle ':omz:update' mode disabled  # disable automatic updates
# zstyle ':omz:update' mode auto      # update automatically without asking
# zstyle ':omz:update' mode reminder  # just remind me to update when it's time

# Uncomment the following line to change how often to auto-update (in days).
# zstyle ':omz:update' frequency 13

# Uncomment the following line if pasting URLs and other text is messed up.
# DISABLE_MAGIC_FUNCTIONS="true"

# Uncomment the following line to disable colors in ls.
# DISABLE_LS_COLORS="true"

# Uncomment the following line to disable auto-setting terminal title.
# DISABLE_AUTO_TITLE="true"

# Uncomment the following line to enable command auto-correction.
# ENABLE_CORRECTION="true"

# Uncomment the following line to display red dots whilst waiting for completion.
# You can also set it to another string to have that shown instead of the default red dots.
# e.g. COMPLETION_WAITING_DOTS="%F{yellow}waiting...%f"
# Caution: this setting can cause issues with multiline prompts in zsh < 5.7.1 (see #5765)
# COMPLETION_WAITING_DOTS="true"

# Uncomment the following line if you want to disable marking untracked files
# under VCS as dirty. This makes repository status check for large repositories
# much, much faster.
# DISABLE_UNTRACKED_FILES_DIRTY="true"

# Uncomment the following line if you want to change the command execution time
# stamp shown in the history command output.
# You can set one of the optional three formats:
# "mm/dd/yyyy"|"dd.mm.yyyy"|"yyyy-mm-dd"
# or set a custom format using the strftime function format specifications,
# see 'man strftime' for details.
# HIST_STAMPS="mm/dd/yyyy"

# Would you like to use another custom folder than $ZSH/custom?
# ZSH_CUSTOM=/path/to/new-custom-folder

# Which plugins would you like to load?
# Standard plugins can be found in $ZSH/plugins/
# Custom plugins may be added to $ZSH_CUSTOM/plugins/
# Example format: plugins=(rails git textmate ruby lighthouse)
# Add wisely, as too many plugins slow down shell startup.

# User configuration
# export MANPATH="/usr/local/man:$MANPATH"

# You may need to manually set your language environment
# export LANG=en_US.UTF-8

# Preferred editor for local and remote sessions
# if [[ -n $SSH_CONNECTION ]]; then
#   export EDITOR='vim'
# else
#   export EDITOR='nvim'
# fi

# Compilation flags
# export ARCHFLAGS="-arch $(uname -m)"

# Set personal aliases, overriding those provided by Oh My Zsh libs,
# plugins, and themes. Aliases can be placed here, though Oh My Zsh
# users are encouraged to define aliases within a top-level file in
# the $ZSH_CUSTOM folder, with .zsh extension. Examples:
# - $ZSH_CUSTOM/aliases.zsh
# - $ZSH_CUSTOM/macos.zsh
# For a full list of active aliases, run `alias`.
#
# Example aliases
# alias zshconfig="mate ~/.zshrc"
# alias ohmyzsh="mate ~/.oh-my-zsh"

# Set PATH, mengambil dari .bashrc dan .zshrc Anda

# User Configuration

# Environment variables dari .bashrc
export LANG=en_US.UTF-8
export LC_ALL=en_US.UTF-8
export PATH="$HOME/.gem/ruby/3.2.0/bin:$PATH"

# brightness
alias b1='sudo brightnessctl set 1%'
alias b5='sudo brightnessctl set 5%'
alias b10='sudo brightnessctl set 10%'
alias b15='sudo brightnessctl set 15%'
alias b20='sudo brightnessctl set 20%'
alias b25='sudo brightnessctl set 25%'
alias b30='sudo brightnessctl set 30%'
alias b35='sudo brightnessctl set 35%'
alias b40='sudo brightnessctl set 40%'
alias b45='sudo brightnessctl set 45%'
alias b50='sudo brightnessctl set 50%'
alias b55='sudo brightnessctl set 55%'
alias b60='sudo brightnessctl set 60%'
alias b65='sudo brightnessctl set 65%'
alias b70='sudo brightnessctl set 70%'
alias b75='sudo brightnessctl set 75%'
alias b80='sudo brightnessctl set 80%'
alias b85='sudo brightnessctl set 85%'
alias b90='sudo brightnessctl set 90%'
alias b95='sudo brightnessctl set 95%'
alias b100='sudo brightnessctl set 100%'

# Aliases untuk mengatur kecerahan layar
alias b01= 'sudo brightnessctl set 1%-'
alias b001= 'sudo brightnessctl set 1%+'

#tmux
alias tsu='sudo tmux'
alias t='tmux'
alias tsc='tmux source-file ~/.config/tmux/tmux.conf'
alias ta='tmux attach'
alias tls='tmux ls'
alias tat='tmux attach -t'
alias tns='tmux new-session -s'
alias tks='tmux kill-session -t'
alias tksa='tmux kill-session -a'
alias ex= 'exit'

#ide
alias ide='bash -x /usr/local/bin/ide.sh'
alias nvcn='nvim ~/.config/nvim/'
alias cdcn='cd ~/.config/nvim/'

#zsh 
alias z='source ~/.zshrc'
alias zn='nvim ~/.zshrc'
alias zdef='sudo chsh -s $(which zsh)'

alias bn='nvim ~/.bashrc'
alias czh='sudo chsh -s /usr/bin/zsh $USER'
alias cbh='sudo chsh -s /bin/bash $USER'

alias psp='ps -p $$'
alias ecsh='echo $SHELL'

#kill
alias ramcheck='ps aux --sort=-%mem | head -n 15'
alias ramcheckc='ps aux --sort=-%mem | head -n 15 | awk '\''{print $1, $2, $4, $11}'\'' | column -t'

# Optimasi utama
alias sysopt='sudo ~/bin/optimize.sh'                    # Optimasi lengkap (RAM + CPU + Cleanup)
alias ramopt='sudo ~/bin/optimize.sh ram --zram 0.25 --swappiness 15'  # RAM dengan ZRAM 25% (default lebih aman)
alias cpuopt='sudo ~/bin/optimize.sh cpu'                # Optimasi CPU
alias cleanopt='sudo ~/bin/optimize.sh cleanup'          # Cleanup sistem

# Optimasi ZRAM
alias ramoptc='sudo ~/bin/optimize.sh ram --zram 0.75 --swappiness 25'  # ZRAM 75%
alias ramopt65='sudo ~/bin/optimize.sh ram --zram 0.65 --swappiness 25'  # ZRAM 65%
alias ramopt60='sudo ~/bin/optimize.sh ram --zram 0.60 --swappiness 20'  # ZRAM 60%
alias ramopt55='sudo ~/bin/optimize.sh ram --zram 0.55 --swappiness 20'  # ZRAM 55%
alias ramopt50='sudo ~/bin/optimize.sh ram --zram 0.5 --swappiness 20'  # ZRAM 50%
alias ramopt49='sudo ~/bin/optimize.sh ram --zram 0.49 --swappiness 20' # ZRAM 49%
alias ramopt45='sudo ~/bin/optimize.sh ram --zram 0.45 --swappiness 20' # ZRAM 45%
alias ramopt35='sudo ~/bin/optimize.sh ram --zram 0.35 --swappiness 15' # ZRAM 35%
alias ramopt30='sudo ~/bin/optimize.sh ram --zram 0.30 --swappiness 15' # ZRAM 30%
alias ramopt25='sudo ~/bin/optimize.sh ram --zram 0.25 --swappiness 15' # ZRAM 25%
alias ramopt20='sudo ~/bin/optimize.sh ram --zram 0.20 --swappiness 15' # ZRAM 20%
alias ramopt15='sudo ~/bin/optimize.sh ram --zram 0.15 --swappiness 10' # ZRAM 15%
alias ramopt10='sudo ~/bin/optimize.sh ram --zram 0.10 --swappiness 10' # ZRAM 10%
alias ramoptno='sudo ~/bin/optimize.sh ram --no-zram'    # RAM tanpa ZRAM
alias ramoptforce='sudo ~/bin/optimize.sh ram --force-zram'  # RAM dengan reset ZRAM paksa
alias sysoptno='sudo ~/bin/optimize.sh --no-zram'        # Optimasi lengkap tanpa ZRAM
alias sysoptforce='sudo ~/bin/optimize.sh --force-zram'  # Optimasi lengkap dengan reset ZRAM paksa

# Monitoring
alias zramstat='zramctl && cat /proc/swaps'              # Cek status ZRAM dan swap
alias memstat='free -h && cat /proc/swaps'               # Cek status memori dan swap

alias zramdev='ls /sys/block/zram* 2>/dev/null || echo "No ZRAM devices found"'  # Cek jumlah perangkat ZRAM
alias zramlog='sudo dmesg | grep zram'                        # Cek log kernel terkait ZRAM

# Aliases dari .bashrc
alias nsu='sudo nvim'
alias c='clear'
alias h='history'
alias p='pwd'
alias ..='cd ..'
alias ...='cd ../..'
alias ....='cd ../../..'
alias .....='cd ../../../..'
alias ......='cd ../../../../..'
alias n.='nvim .'
alias n='nvim'

# git
alias g='git'
alias gncf='nvim ~/.gitconfig'

alias c.='code .'
alias lst='tree -a -s -t -C -L 1'
alias lsta='tree -a -s -t -C'
alias lstar='tree -a -s -t -C | less -R'
alias lstarf='tree -a -s -t -C -I "*.bak|node_modules|.git|dist|logs|migrations"' # | less -R
alias ls='lsd --icon always'
alias ll='lsd -la --icon always'
alias la='lsd -a --icon always'
#alias l='lsd --icon always'
alias dfh='df -h' # disk free, in Gigabytes, not bytes
alias duhc='du -h -c' # calculate disk usage for a folder
alias freeh='free -h' # memory free, in human, not bytes
alias lpath='echo $PATH | tr ":" "\n"' # list the PATH separated by new lines

# npm
alias ns='npm run start'
alias nsd='npm run start:dev'
alias nss='npm run start:stag'
alias nsp='npm run start:prod'

# nvim
alias nvcp='nvim ~/Documents/cache-project/'
alias nvgfe='nvim ~/Documents/gmf-training/frontend/'
alias nvgbe='nvim ~/Documents/gmf-training/backend/'


# postman
alias postman='/opt/Postman/app/Postman'

# gmf-training
alias cogfe='code ~/Documents/gmf-training/frontend'
alias cogbe='code ~/Documents/gmf-training/backend'
alias cdgmf='cd ~/Documents/gmf-training'
alias cdgfe='cd ~/Documents/gmf-training/frontend'
alias cdgbe='cd ~/Documents/gmf-training/backend'
alias cdgf='cd ~/Documents/gmf/frontend'
alias cdgb='cd ~/Documents/gmf/backend'

# cache-project
alias cocp='code ~/Documents/cache-project'
alias cdcp='cd ~/Documents/cache-project'

# show.sh
alias sosh='bash /usr/local/bin/show.sh'

# swapon
alias sosw='swapon --show' 
alias swoff='sudo swapoff -a'
alias swon='sudo swapon -a'

# docker-portainer
alias setupdp='/usr/local/bin/setupdp.sh'

# cekul code
alias coceka='code ~/Documents/cekulit/auth-main'
alias cocekp='code ~/Documents/cekulit/predict-main'
alias cdceka='cd ~/Documents/cekulit/auth-main'
alias cdcekp='cd ~/Documents/cekulit/predict-main'

# ls aliases dari .bashrc
alias ls='ls --color=auto'
alias ll='ls -alF'
alias la='ls -A'
alias l='ls -CF'

# grep aliases dari .bashrc
alias grep='grep --color=auto'
alias fgrep='fgrep --color=auto'
alias egrep='egrep --color=auto'

# pyenv dari .bashrc
export PYENV_ROOT="$HOME/.pyenv"
[[ -d $PYENV_ROOT/bin ]] && export PATH="$PYENV_ROOT/bin:$PATH"
eval "$(pyenv init --path)"
eval "$(pyenv init -)"
eval "$(pyenv virtualenv-init -)"

# nvm dari .bashrc
export NVM_DIR="$HOME/.nvm"
[ -s "$NVM_DIR/nvm.sh" ] && \. "$NVM_DIR/nvm.sh"
[ -s "$NVM_DIR/bash_completion" ] && \. "$NVM_DIR/bash_completion"

# rbenv dari .bashrc
eval "$(rbenv init - zsh)"  # Gunakan 'zsh' untuk inisialisasi di Zsh

# zoxide dari .bashrc
eval "$(zoxide init zsh)"  # Ganti 'bash' dengan 'zsh'

# Angular CLI autocompletion dari .bashrc
source <(ng completion script)

# To customize prompt, run `p10k configure` or edit ~/.p10k.zsh.
[[ ! -f ~/.p10k.zsh ]] || source ~/.p10k.zsh
export PATH="$HOME/.cargo/bin:$PATH"

. "$HOME/.local/bin/env"
export PATH="$HOME/.local/bin:$PATH"
eval "$(/home/linuxbrew/.linuxbrew/bin/brew shellenv)"
