# /etc/fstab: static file system information.
#
# Use 'blkid' to print the universally unique identifier for a
# device; this may be used with UUID= as a more robust way to name devices
# that works even if disks are added and removed. See fstab(5).
#
# <file system> <mount point>   <type>  <options>       <dump>  <pass>
# / was on /dev/sda4 during curtin installation
/dev/disk/by-uuid/93cc03f5-b130-4c41-b8ee-754d3a1da1ba / ext4 defaults,commit=60,noatime,errors=remount-ro 0 1
# /boot was on /dev/sda2 during curtin installation
/dev/disk/by-uuid/00511fe9-2d72-46b4-9dcd-6c5ede70de88 /boot ext4 defaults,noatime 0 1
# /boot/efi was on /dev/sda3 during curtin installation
/dev/disk/by-uuid/F30B-919B /boot/efi vfat defaults 0 1

# ZRAM is used as primary swap (fast, compressed in RAM)
# /dev/zram0 (dikelola otomatis oleh systemd-zram-generator) none swap defaults,pri=100 0 0
# REMOVED: /swapfile1 - swap pada SSD eksternal USB menyebabkan I/O thrashing dan freeze
