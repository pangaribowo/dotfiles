[Unit]
Description=Enable Intel HWP Dynamic Boost and Scale Clock
After=multi-user.target

[Service]
Type=oneshot
ExecStart=/bin/sh -c 'echo 1 > /sys/devices/system/cpu/intel_pstate/hwp_dynamic_boost && for f in /sys/devices/system/cpu/cpu*/cpufreq/energy_performance_preference; do echo balance_performance > "$f"; done'
RemainAfterExit=yes

[Install]
WantedBy=multi-user.target
